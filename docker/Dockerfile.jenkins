# Jenkins LTS (JDK 21) + Docker CLI + kubectl for CircleGuard pipelines.
# Uses the host Docker daemon via mounted /var/run/docker.sock (see docker-compose.jenkins.yml).
FROM jenkins/jenkins:lts-jdk21

USER root

# Client only (talks to the host daemon via /var/run/docker.sock). On Debian 13+ `docker.io` no longer
# pulls the CLI when using --no-install-recommends — the `docker` binary is in package `docker-cli`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && docker --version

# Buildx plugin: required if pipelines use DOCKER_BUILDKIT=1 (docker-cli alone enables BuildKit but needs this binary).
# Pin release: https://github.com/docker/buildx/releases
ARG BUILDX_VERSION=v0.33.0
RUN set -eu \
    && ARCH="$(uname -m)" \
    && case "$ARCH" in aarch64 | arm64) BARCH=arm64 ;; *) BARCH=amd64 ;; esac \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL \
        "https://github.com/docker/buildx/releases/download/${BUILDX_VERSION}/buildx-${BUILDX_VERSION}.linux-${BARCH}" \
        -o /usr/local/lib/docker/cli-plugins/docker-buildx \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx \
    && docker buildx version

# Pin kubectl to the same minor as bundled k3s in docker-compose.jenkins.yml (skew ±1).
ARG KUBECTL_VERSION=v1.28.15
RUN set -eu \
    && ARCH="$(uname -m)" \
    && case "$ARCH" in aarch64 | arm64) KARCH=arm64 ;; *) KARCH=amd64 ;; esac \
    && curl -fsSL -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KARCH}/kubectl" \
    && chmod +x /usr/local/bin/kubectl

COPY docker/jenkins-kubeconfig-init.sh /usr/local/bin/jenkins-kubeconfig-init.sh
RUN chmod +x /usr/local/bin/jenkins-kubeconfig-init.sh \
    && sed -i 's/\r$//' /usr/local/bin/jenkins-kubeconfig-init.sh

# Root so the entrypoint can write ~/.kube/config when /k3s-etc is mounted (local compose uses user 0:0).
USER root
ENTRYPOINT ["/usr/local/bin/jenkins-kubeconfig-init.sh"]
