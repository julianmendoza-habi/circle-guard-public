# syntax=docker/dockerfile:1
# Runtime image for CircleGuard Spring Boot services (Java 21).
# Build fat JARs on the host or CI first, then image build only copies the JAR (fast, small context).
#
#   ./gradlew :services:circleguard-auth-service:bootJar -x test --no-daemon
#   docker build -f docker/Dockerfile.service --build-arg SERVICE_DIR=circleguard-auth-service -t circleguard/auth-service:local .

ARG SERVICE_DIR=circleguard-auth-service

FROM eclipse-temurin:21-jre-alpine
ARG SERVICE_DIR=circleguard-auth-service
WORKDIR /app
RUN addgroup -g 1000 circleguard && adduser -u 1000 -G circleguard -D circleguard
COPY services/${SERVICE_DIR}/build/libs/*.jar /app/app.jar
USER circleguard:circleguard
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
